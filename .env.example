YC_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/authorized_key.json
YC_FOLDER_ID=
PROJECT_NAME=tg-serverless-example
# Remote Terraform state (S3-compatible Yandex Object Storage).
# Create the bucket with `npm run infra:bootstrap` before `infra:plan`.
TF_STATE_BUCKET=
TF_STATE_KEY=
TF_STATE_REGION=ru-central1
TF_STATE_ENDPOINT=https://storage.yandexcloud.net
# Required only for reset-folder destroy: account that owns the active S3 key.
TF_STATE_SERVICE_ACCOUNT_ID=
# State credentials are read from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# in the process environment. Do not commit real keys.
BOT_TOKEN=
BOT_SECRET_ID=
BOT_SECRET_VERSION_ID=
BOT_SECRET_KEY=BOT_TOKEN
EXISTING_YDB_ID=
TG_PROXY_BASE=https://api.telegram.org/bot
TELEGRAM_TRIGGER_NAME=tg-serverless-example-telegram
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
TELEGRAM_AUTH_FUTURE_SKEW_SECONDS=30
